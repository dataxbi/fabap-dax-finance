EVALUATE
TOPN(
    24,
    SUMMARIZECOLUMNS(
        'Fecha'[Year Month Sort],
        'Fecha'[Year Month],
        "Importe", [Importe],
        "Presupuesto", [Presupuesto],
        "Gastos", [Gastos],
        "EBITDA", [EBITDA],
        "Cash Flow", [Cash Flow]
    ),
    'Fecha'[Year Month Sort], DESC
)
ORDER BY 'Fecha'[Year Month Sort]
